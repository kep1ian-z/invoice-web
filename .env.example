# Notion 연동 및 운영 관련 환경 변수 (docs/PRD.md 6번 섹션 참고)
# 실제 값은 .env.local 등에만 설정하고 커밋하지 마세요. 배포(Vercel)에서는 프로젝트 환경 변수에 설정합니다.

# Notion Integration 토큰 (Notion Integration 생성 후 발급되는 Internal Integration Secret, 필수)
NOTION_API_KEY=

# 견적서 데이터가 저장된 Notion 데이터베이스 ID (필수)
NOTION_DATABASE_ID=

# 로그 레벨 (선택, 기본값: 개발 debug / 운영 info). 열람 이력(quote_view)은 info 레벨로 기록됩니다.
# LOG_LEVEL=info

# 로컬 개발에서 PDF 생성에 사용할 Chrome/Edge 실행 파일 경로 (선택).
# 비워 두면 일반적인 설치 경로를 자동으로 찾습니다. Vercel에서는 사용하지 않습니다.
# PDF_BROWSER_PATH=
